
/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////
Enum space_visibility {
  private
  unlisted
}

Enum progress_status {
  new
  learning
  mastered
}

Enum session_mode {
  quick
  overall
}

Enum session_method {
  MCQ
  CLOZE
  FEYNMAN
  MIXED
}

Enum task_status {
  new
  inprogress
  done
}

/////////////////////////////////////////////////
// CORE DJANGO
/////////////////////////////////////////////////
Table django_content_type {
  id int [pk]
  app_label varchar
  model varchar
  Note: 'Tabla estándar de Django para GenericForeignKey'
  indexes {
    (app_label, model) [unique, name: 'uniq_app_model']
  }
}

/////////////////////////////////////////////////
// USUARIOS (EXISTENTE)
/////////////////////////////////////////////////
Table API_user {
  id int [pk]
  username varchar
  email varchar
  password varchar
  created_at datetime
  updated_at datetime
  indexes {
    (email) [unique, name: 'uniq_user_email']
  }
}

/////////////////////////////////////////////////
// DOCUMENTOS (EXISTENTE)
/////////////////////////////////////////////////
